  "business_rules": {
    "BR-1": "Only the maintenance/operator agent may write PLC registers, and setpoints must stay within the safe range.",
    "BR-2": "Cameras stream to the local gateway only, never to the internet.",
    "BR-3": "Gate release requires matching container + truck + booking.",
    "BR-4": "No agent may subscribe to the wildcard topic #.",
    "BR-5": "Reefer temperature changes greater than 10\u00b0C in one minute are implausible and must be flagged, not acted on.",
    "BR-6": "Any traffic to the PLC that bypasses the gateway is denied and flagged.",
    "BR-7": "Unknown or revoked identities are denied by default, with no re-evaluation.",
    "BR-8": "Per-agent rate cap: any agent exceeding its publish/action rate is throttled, then quarantined on repeat.",
    "BR-9": "Malformed or out-of-range writes are rejected by condition check, not passed to the device."
  },
