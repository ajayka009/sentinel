  "semantics": {
    "evaluation": "unknown-or-revoked short-circuits to deny; then deny/quarantine/flag before allow (deny-override); first match in file order wins within each class",
    "default": "deny (pol-br7-default-deny catch-all, last rule)",
    "subject_match": "exact graph node id or '*'",
    "resource_match": "fnmatch glob: rule resource is the pattern, action resource the string",
    "conditions": "conjunction; empty matches; numeric ops on non-numeric values are false",
    "gateway_relay": "post-decision mechanism, not re-evaluated"
  },
