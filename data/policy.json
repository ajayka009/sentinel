{
  "version": 1,
  "rules": [
    {
      "id": "pol-br1-allow-plc-write",
      "business_rule": "BR-1",
      "origin": "business-rule",
      "subject": "operator-agent",
      "action": "write",
      "resource": "plc.*",
      "conditions": [
        {
          "field": "via_gateway",
          "op": "eq",
          "value": true
        },
        {
          "field": "value",
          "op": "gte",
          "value": 0
        },
        {
          "field": "value",
          "op": "lte",
          "value": 1500
        }
      ],
      "effect": "allow",
      "description": "Operator PLC writes within the safe range (0-1500 RPM) relayed through the gateway."
    },
    {
      "id": "pol-br2-allow-local-stream",
      "business_rule": "BR-2",
      "origin": "business-rule",
      "subject": "camera-line1",
      "action": "stream",
      "resource": "camera.frames",
      "conditions": [
        {
          "field": "destination",
          "op": "eq",
          "value": "edge-gateway"
        }
      ],
      "effect": "allow",
      "description": "Camera frames stream to the local gateway."
    },
    {
      "id": "pol-br2-deny-internet",
      "business_rule": "BR-2",
      "origin": "business-rule",
      "subject": "camera-line1",
      "action": "stream",
      "resource": "camera.frames",
      "conditions": [
        {
          "field": "destination",
          "op": "eq",
          "value": "internet"
        }
      ],
      "effect": "deny",
      "description": "Camera streams to the internet are denied."
    },
    {
      "id": "pol-br3-allow-booked-release",
      "business_rule": "BR-3",
      "origin": "business-rule",
      "subject": "operator-agent",
      "action": "publish",
      "resource": "topic:site/yard/gate/release",
      "conditions": [
        {
          "field": "booking_match",
          "op": "eq",
          "value": true
        }
      ],
      "effect": "allow",
      "description": "Booked gate releases (container + truck + booking match)."
    },
    {
      "id": "pol-br3-quarantine-unbooked",
      "business_rule": "BR-3",
      "origin": "business-rule",
      "subject": "*",
      "action": "publish",
      "resource": "topic:site/yard/gate/release",
      "conditions": [
        {
          "field": "booking_match",
          "op": "eq",
          "value": false
        }
      ],
      "effect": "quarantine",
      "description": "Unbooked gate release attempts quarantine the requester."
    },
    {
      "id": "pol-br4-allow-gateway-wildcard",
      "business_rule": "BR-4",
      "origin": "business-rule",
      "subject": "edge-gateway",
      "action": "subscribe",
      "resource": "*",
      "conditions": [
        {
          "field": "filter_has_wildcard",
          "op": "eq",
          "value": true
        }
      ],
      "effect": "allow",
      "description": "The gateway alone may hold wildcard subscribes."
    },
    {
      "id": "pol-br4-quarantine-wildcard",
      "business_rule": "BR-4",
      "origin": "business-rule",
      "subject": "*",
      "action": "subscribe",
      "resource": "*",
      "conditions": [
        {
          "field": "filter_has_wildcard",
          "op": "eq",
          "value": true
        },
        {
          "field": "subject",
          "op": "ne",
          "value": "edge-gateway"
        }
      ],
      "effect": "quarantine",
      "description": "Non-gateway wildcard subscribes (recon) quarantine the requester."
    },
    {
      "id": "pol-br5-flag-implausible-reefer",
      "business_rule": "BR-5",
      "origin": "business-rule",
      "subject": "*",
      "action": "publish",
      "resource": "topic:site/yard/reefer/*/temperature",
      "conditions": [
        {
          "field": "delta_c_per_min",
          "op": "gt",
          "value": 10
        }
      ],
      "effect": "flag",
      "description": "Reefer temperature jumps over 10C/min are implausible: flagged, never acted on."
    },
    {
      "id": "pol-br6-deny-bypass",
      "business_rule": "BR-6",
      "origin": "business-rule",
      "subject": "*",
      "action": "write",
      "resource": "plc.*",
      "conditions": [
        {
          "field": "via_gateway",
          "op": "eq",
          "value": false
        }
      ],
      "effect": "deny",
      "description": "Direct-to-PLC writes bypassing the gateway are denied and audit-flagged as an anomaly."
    },
    {
      "id": "pol-br8-throttle-flood",
      "business_rule": "BR-8",
      "origin": "business-rule",
      "subject": "*",
      "action": "*",
      "resource": "*",
      "conditions": [
        {
          "field": "subject_kind",
          "op": "eq",
          "value": "agent"
        },
        {
          "field": "rate_per_min",
          "op": "gt",
          "value": 30
        },
        {
          "field": "repeat",
          "op": "eq",
          "value": false
        }
      ],
      "effect": "flag",
      "description": "First rate-cap breach throttles the agent (flag + audit)."
    },
    {
      "id": "pol-br8-quarantine-repeat",
      "business_rule": "BR-8",
      "origin": "business-rule",
      "subject": "*",
      "action": "*",
      "resource": "*",
      "conditions": [
        {
          "field": "subject_kind",
          "op": "eq",
          "value": "agent"
        },
        {
          "field": "rate_per_min",
          "op": "gt",
          "value": 30
        },
        {
          "field": "repeat",
          "op": "eq",
          "value": true
        }
      ],
      "effect": "quarantine",
      "description": "Repeat rate-cap breach quarantines the agent."
    },
    {
      "id": "pol-br9-deny-malformed",
      "business_rule": "BR-9",
      "origin": "business-rule",
      "subject": "*",
      "action": "write",
      "resource": "plc.*",
      "conditions": [
        {
          "field": "wellformed",
          "op": "eq",
          "value": false
        }
      ],
      "effect": "deny",
      "description": "Malformed PLC writes are rejected by condition check, never passed to the device."
    },
    {
      "id": "pol-br9-deny-below-range",
      "business_rule": "BR-9",
      "origin": "business-rule",
      "subject": "*",
      "action": "write",
      "resource": "plc.*",
      "conditions": [
        {
          "field": "value",
          "op": "lt",
          "value": 0
        }
      ],
      "effect": "deny",
      "description": "PLC writes below 0 are rejected by condition check."
    },
    {
      "id": "pol-br9-deny-above-range",
      "business_rule": "BR-9",
      "origin": "business-rule",
      "subject": "*",
      "action": "write",
      "resource": "plc.*",
      "conditions": [
        {
          "field": "value",
          "op": "gt",
          "value": 1500
        }
      ],
      "effect": "deny",
      "description": "PLC writes above 1500 RPM are rejected by condition check."
    },
    {
      "id": "pol-br7-deny-unknown-revoked",
      "business_rule": "BR-7",
      "origin": "business-rule",
      "subject": "*",
      "action": "*",
      "resource": "*",
      "conditions": [
        {
          "field": "identity_status",
          "op": "in",
          "value": [
            "unknown",
            "revoked",
            "expired"
          ]
        }
      ],
      "effect": "deny",
      "description": "Unknown, revoked, or expired identities are denied immediately with no re-evaluation."
    },
